# Shared server-side cloud profile. Copy to .env and keep it out of Git.
# DATABASE_URL must be a Postgres URL, never a `psql ...` shell command.
# Use Neon's pooled URL for normal application traffic.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Use the direct/unpooled URL for migrations, pg_dump, and pg_restore.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Prefer a separate logical database per stateful product in production.
REELFORGE_DATABASE_URL=
MINT_DATABASE_URL=
VEND_DATABASE_URL=
LEDGERLINE_DATABASE_URL=
RELAY_DATABASE_URL=

# Cloudflare R2 S3-compatible runtime credentials. Use a least-privilege
# object read/write token, not an account-level bucket administration token.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Temporary/local shared bucket. Production should set per-product bucket names
# and inject a token scoped to that product's bucket into its runtime.
R2_BUCKET_NAME=videogen
REELFORGE_R2_BUCKET_NAME=
RELAY_R2_BUCKET_NAME=
R2_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# Public/custom-domain origin for browser-consumable assets; not the S3 endpoint.
R2_PUBLIC_BASE_URL=

# RevenueCat server-side subscriber verification for protected export/share.
# Never expose this secret through EXPO_PUBLIC_* variables.
REVENUECAT_SECRET_API_KEY=
# Server-only HMAC secret for mobile device onboarding. Use 32+ random chars.
REELFORGE_DEVICE_AUTH_SECRET=
REVENUECAT_PRO_ENTITLEMENT_ID=pro
REVENUECAT_API_BASE_URL=https://api.revenuecat.com/v1
REVENUECAT_TIMEOUT_SECONDS=5

# RocketRide runtime. These are server-only; clients select only local/managed.
# The local extension URI is dynamic, so copy its current value instead of
# assuming a fixed port. Both targets use the same editor-authored .pipe.
ROCKETRIDE_LOCAL_URI=
ROCKETRIDE_LOCAL_API_KEY=
ROCKETRIDE_MANAGED_URI=
ROCKETRIDE_MANAGED_API_KEY=
ROCKETRIDE_PIPELINE_ROOT=pipelines/rocketride
ROCKETRIDE_PIPELINE_FILE=
