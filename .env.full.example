# =============================================================================
# ReelForge FULL local stack — environment template.
#
#   cp .env.full.example .env.full
#
# Consumed by docker-compose.full.yml (env_file:) for the api / worker / beat /
# migrate / postgres services, and by scripts/dev-bootstrap.sh for local runs.
#
# This file DELIBERATELY differs from .env.reelforge.example in one way: it wires
# a *fully local* Postgres (the `postgres` service) instead of a remote Neon URL,
# so the whole stack comes up with `make -f Makefile.dev up` and ZERO external
# accounts. Swap the placeholders below for real provider keys to exercise the
# live pipeline (script → TTS → avatar → compose → publish).
#
# NEVER commit `.env.full`. Everything here is a NON-SECRET placeholder.
# =============================================================================

# -----------------------------------------------------------------------------
# Database — LOCAL Postgres (the `postgres` service in docker-compose.full.yml).
# SQLAlchemy + Alembic read NEON_DATABASE_URL (app/config/config.py, migrations/
# env.py). The psycopg (v3) driver form is required for SQLAlchemy 2.0. The host
# `postgres` resolves on the compose network; the credentials below MUST match
# the POSTGRES_* values further down (they seed the same database).
# -----------------------------------------------------------------------------
NEON_DATABASE_URL=postgresql+psycopg://reelforge:reelforge@postgres:5432/reelforge

# POSTGRES_* configure the bundled `postgres` container itself.
POSTGRES_USER=reelforge
POSTGRES_PASSWORD=reelforge
POSTGRES_DB=reelforge

# -----------------------------------------------------------------------------
# Redis — Celery broker + result backend AND MPT task-state store.
# In docker-compose.full.yml REDIS_HOST is pinned to the `redis` service (this
# value is overridden there); keep `redis` here so a bare `docker run` also works.
# celery_broker_url / celery_result_backend are OPTIONAL overrides composed from
# these values in celery_app.py::_redis_url() when unset.
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Object storage — Cloudflare R2 (S3-compatible). config §2.7 / §3.
# docker/worker-entrypoint.sh FAILS FAST if any R2_* (or NEON_DATABASE_URL) is
# empty, so the worker never crash-loops mid-pipeline. The placeholders below are
# non-empty ON PURPOSE so the stack boots; real uploads need real credentials.
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=local-dev-account
R2_ACCESS_KEY_ID=local-dev-access-key
R2_SECRET_ACCESS_KEY=local-dev-secret-key
R2_BUCKET=reelforge-dev
R2_PUBLIC_BASE_URL=http://localhost:8080/tasks

# -----------------------------------------------------------------------------
# LLM — Claude via litellm (script generation). config §2.1 / §3.
# litellm reads ANTHROPIC_API_KEY from the environment directly.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# TTS — ElevenLabs /with-timestamps adapter (timing authority). config §3.3 / §9.
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=

# -----------------------------------------------------------------------------
# Avatar — HeyGen v2 audio-driven talking head. config §2.4 / §3.
# -----------------------------------------------------------------------------
HEYGEN_API_KEY=

# -----------------------------------------------------------------------------
# AI B-roll studio — comfyui-deploy (text/image -> motion clip on serverless GPU).
# Self-host https://github.com/BennyKok/comfyui-deploy and deploy a Wan/LTX
# workflow, then set the instance URL + API key + deployment id(s) below.
# Leave empty to disable AI B-roll (the provider reports is_enabled()=False and
# stock B-roll still works). config: AI_BROLL_STUDIO_PLAN.md §4.6.
# -----------------------------------------------------------------------------
COMFYUI_BASE_URL=
COMFYUI_API_KEY=
COMFYUI_DEPLOYMENT_ID=
COMFYUI_DEPLOYMENT_ID_I2V=

# -----------------------------------------------------------------------------
# API — CORS origins consumed by app/asgi.py (comma-separated; "*" = allow all).
# The local web app is served from http://localhost:3000.
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=*

# -----------------------------------------------------------------------------
# Web (Next.js) — build-time + runtime env for the `web` service.
# NEXT_PUBLIC_* are inlined by `next build`, so they are passed as build args in
# docker-compose.full.yml. Point the browser at the host-published API port.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_API_KEY=local-dev-app-key
# Clerk auth — the web app uses @clerk/nextjs. Fill these with real keys for a
# fully functional sign-in flow; a build succeeds with placeholders but auth-gated
# pages will not render until valid keys are provided.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# -----------------------------------------------------------------------------
# ops/smoke.py + ops/seed.py knobs (host-side; sensible defaults, override freely).
# SMOKE_API_URL / SMOKE_WEB_URL are the HOST-published URLs the smoke test probes.
# -----------------------------------------------------------------------------
SMOKE_API_URL=http://localhost:8080
SMOKE_WEB_URL=http://localhost:3000
SMOKE_REDIS_HOST=127.0.0.1
SMOKE_REDIS_PORT=6379
SEED_USER_EMAIL=demo@reelforge.local
