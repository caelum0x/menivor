  "validate": {
    "ig_bad_aspect": {
      "args": [
        "instagram",
        30,
        "21:9",
        50,
        "mp4"
      ],
      "errors": [
        "instagram: aspect 21:9 not in ['9:16', '1:1', '4:5']"
      ]
    },
    "tiktok_ok": {
      "args": [
        "tiktok",
        30,
        "9:16",
        100,
        "mp4"
      ],
      "errors": []
    },
    "x_caption_over": {
      "args": [
        "x",
        30,
        "9:16",
        500,
        "mp4"
      ],
      "errors": [
        "x: caption 500 chars over max 280"
      ]
    },
    "yt_too_long": {
      "args": [
        "youtube",
        200,
        "9:16",
        50,
        "mp4"
      ],
      "errors": [
        "youtube: duration 200s over max 180s"
      ]
    }
