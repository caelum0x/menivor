{
  "name": "@menivor/sdk",
  "version": "0.1.0",
  "description": "Tiny, dependency-free TypeScript client for the Menivor /api/v1 platform.",
  "license": "MIT",
  "homepage": "https://menivor.com/developer",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "menivor",
    "sdk",
    "api",
    "video",
    "webhooks"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@reelforge/api-contract": "file:../api-contract"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
