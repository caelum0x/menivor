# ReelForge web — copy to `.env.local` and fill in real values.
#   cp .env.example .env.local
# NEVER commit `.env.local`. NEXT_PUBLIC_* values are exposed to the browser
# by design; do not put real secrets in NEXT_PUBLIC_* vars.

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
# Base URL of the ReelForge v1 API (must include the /api/v1 prefix).
# Deployed production origin: https://api.menivor.com/api/v1
# Use the localhost value below only when running the FastAPI backend locally.
NEXT_PUBLIC_API_BASE=http://localhost:8080/api/v1
# Pricing page fallback only (used when the API cannot be read at render time).
# The live catalog from GET /billing/monthly-plans always wins. "1" = monthly
# and yearly plans on sale, "month" = monthly only, unset = "Not on sale yet".
NEXT_PUBLIC_MONTHLY_PLANS_ON_SALE=

# Public app-level API key sent as the `x-api-key` header when no Clerk JWT
# and no device-session key are available. Safe to expose; scope it to the
# frontend. Leave BLANK to rely on the zero-signup device session
# (src/shared/device, which exchanges an install id at POST /auth/device for a
# per-install key) plus per-request Clerk tokens — the default posture.
NEXT_PUBLIC_APP_API_KEY=

# ---------------------------------------------------------------------------
# Clerk auth (email + Google). Keys from the Clerk dashboard.
#   Publishable key is browser-safe; the secret key is server-only.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk route hints (optional overrides; defaults match app/ structure).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/reels
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/reels
# Optional Clerk Frontend API proxy (see README "Clerk Frontend API proxy").
# Leave empty to use the FAPI domain in the publishable key.
NEXT_PUBLIC_CLERK_PROXY_URL=

# Google Search Console HTML-tag verification token. Paste only the token
# value, not the full <meta> element.
GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# TypeSafe / Jev (server-only) — powers the Winning Hook Finder
# (POST /api/v1/growth/rank-hooks). SERVER-ONLY secret: NOT a NEXT_PUBLIC_* var,
# so it never reaches the browser. On Cloudflare set it as a Worker secret
# (`wrangler secret put TYPESAFE_API_KEY`); locally put it in `.env.local`.
# When BLANK the route degrades gracefully to a transparent text heuristic
# (engine: "heuristic") and logs a warning — it never fakes Jev output.
TYPESAFE_API_KEY=
# Optional overrides (defaults: https://api.typesafe.ai/v1 and jev-latest).
# TYPESAFE_BASE_URL=
# TYPESAFE_MODEL=

# ---------------------------------------------------------------------------
# Newsletter (server-only) — POST /api/newsletter proxies the footer signup to
# our self-hosted listmonk (infra-box/stacks/listmonk) public subscription API.
# LISTMONK_LIST_UUID = UUID of the public, double-opt-in `menivor-updates` list
# (printed by stacks/listmonk/bootstrap.py). No listmonk admin credentials are
# needed or read by the web app. When blank the route returns 503 with a clear
# "not switched on yet" message. On Cloudflare: plain Worker vars are fine.
LISTMONK_URL=
LISTMONK_LIST_UUID=

# MN7a: SSO & SCIM settings stay hidden and show "contact sales" until real SSO
# ships (MN7b). Set to 1 only together with MENIVOR_SSO_ENABLED=1 on the API.
NEXT_PUBLIC_MENIVOR_SSO_ENABLED=

# ---------------------------------------------------------------------------
# Browser error reporting (any Sentry-compatible ingest, e.g. self-hosted
# GlitchTip or Sentry). Public ingest key/DSN, baked in at build time, because
# Next.js inlines NEXT_PUBLIC_* at `next build`. Unset means the client-side
# reporter (src/shared/observability) stays off.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GLITCHTIP_DSN=
NEXT_PUBLIC_GLITCHTIP_RELEASE=

# ---------------------------------------------------------------------------
# MCP publishing tools (server-only). schedule_publish and list_scheduled stay
# hidden from tools/list, and calls are rejected with "not available yet",
# until this is 1, true, yes, or on. Direct social posting is closed, so leave
# it unset. On Cloudflare set the same name as a Worker var (not NEXT_PUBLIC_*).
# MENIVOR_MCP_PUBLISHING_TOOLS=

# MCP Buffer / Typefully tools (server-only). list_scheduler_accounts and
# schedule_to_buffer_or_typefully stay hidden, and calls are rejected, until
# this is 1, true, yes, or on. Separate from MENIVOR_MCP_PUBLISHING_TOOLS so
# turning this on does not re-advertise native posting. The API also needs
# SOCIAL_TOKEN_KEY (encrypts the pasted keys) and `alembic upgrade head`
# (scheduler_connections). On Cloudflare set this as a Worker var, not NEXT_PUBLIC_*.
# MENIVOR_MCP_SCHEDULER_TOOLS=
