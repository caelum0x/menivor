# ReelForge API — self-contained docker-compose env template.
# Copy to apps/api/.env and fill in real values. NEVER commit apps/api/.env.
#
#   cd apps/api && cp .env.example .env
#
# Only NON-EMPTY values override config.toml. In the default internal_pilot
# launch mode every provider/billing key below is OPTIONAL: the API still boots
# and serves /api/v1 (device sessions, catalogs, jobs, health). Provider keys
# only gate the features that use them (script gen, TTS, avatars, checkout).

# === CORE (required for the mobile app to work end-to-end) ==================
# HMAC secret for POST /api/v1/auth/device (mobile createDeviceSession). MUST be
# >= 32 chars or device onboarding returns 503. Generate: openssl rand -hex 32
REELFORGE_DEVICE_AUTH_SECRET=REPLACE_WITH_openssl_rand_hex_32_min_32_chars

# Launch posture. internal_pilot = warn-only preflight (boots without provider
# keys). Do NOT set "public" until every production key below is real.
REELFORGE_LAUNCH_MODE=internal_pilot

# Browser CORS origins (comma-separated). Mobile/native clients ignore CORS; set
# your web origin(s) for the web client. "*" allows all (no credentialed cookies).
CORS_ALLOWED_ORIGINS=*

# === DATABASE (Postgres) ====================================================
# Pinned to the compose `db` service by docker-compose.yml; override only to use
# an external Postgres/Neon. SQLAlchemy 2.0 psycopg v3 driver form.
REELFORGE_DATABASE_URL=postgresql+psycopg://reelforge:reelforge@db:5432/reelforge

# === REDIS (Celery broker + task state) =====================================
# Host is pinned to the compose `redis` service in docker-compose.yml.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# === OBJECT STORAGE (Cloudflare R2 / S3) ====================================
# PRODUCTION: point these at real Cloudflare R2 (the deployed stack does — see
# DEPLOY.md "Public storage = Cloudflare R2"). Presigned upload/preview URLs
# are minted from R2_S3_ENDPOINT, so it must be the public HTTPS R2 origin for
# clients outside the compose network.
# LOCAL/OFFLINE dev only: the bundled MinIO can back these instead (set
# R2_S3_ENDPOINT=http://minio:9000 plus R2_ALLOW_INSECURE_HTTP=1); with that,
# public clients cannot fetch media and the /readyz R2 check stays "down".
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-s3-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-s3-secret-access-key>
R2_BUCKET_NAME=videogen
REELFORGE_R2_BUCKET_NAME=videogen
# Real R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com  (local dev: http://minio:9000)
R2_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Public/CDN origin for client-consumable asset URLs (not the S3 endpoint):
# the bucket's r2.dev managed domain or a custom domain.
R2_PUBLIC_BASE_URL=https://pub-<bucket-id>.r2.dev

# Bundled MinIO service credentials (offline dev only — deliberately decoupled
# from R2_* so real R2 secrets never enter the MinIO container). Compose
# defaults: reelforge / reelforge-local-secret / bucket "reelforge".
#MINIO_ROOT_USER=reelforge
#MINIO_ROOT_PASSWORD=reelforge-local-secret
#MINIO_BUCKET=reelforge

# === REEL PROVIDER CREDENTIALS (optional in internal_pilot) =================
# Claude (script generation via litellm). Empty = script stage unavailable.
ANTHROPIC_API_KEY=
# ElevenLabs TTS (/with-timestamps timing authority). Empty = TTS unavailable.
ELEVENLABS_API_KEY=
# HeyGen audio-driven talking-head avatars. Empty = avatar creation returns 503.
HEYGEN_API_KEY=

# === AI B-ROLL PROVIDER (comfyui-deploy) — optional =========================
# BROLL_GEN_PROVIDER=comfyui  # or "pixelle" / "replicate"; only for the B-roll studio
COMFYUI_BASE_URL=
COMFYUI_API_KEY=
COMFYUI_DEPLOYMENT_ID=
# Pinned comfy-workflow-schema slug per B-roll mode (enforced at dispatch: a
# changed node commit in the catalog => a new FNV-1a graph_hash version). Leave
# unset to use the built-in Wan defaults (t2v=wan-i2v,i2v=wan-i2v).
# COMFYUI_WORKFLOW_SLUGS=t2v=wan-i2v,i2v=wan-i2v

# === AI VIDEO via Replicate (BROLL_GEN_PROVIDER=replicate) — optional =======
# Hosted Wan 2.2 text/image->video, billed per output second by Replicate.
# ALWAYS set a hard spend limit at replicate.com before enabling.
REPLICATE_API_TOKEN=
# Cheapest/fastest official Wan variants are the defaults; override if needed.
# REPLICATE_WAN_T2V_MODEL=wan-video/wan-2.2-t2v-fast
# REPLICATE_WAN_I2V_MODEL=wan-video/wan-2.2-i2v-fast
# === PLUGGABLE VIDEO ROUTING (marketplace adapters) — all optional ==========
# Each provider becomes a live route only when its key is present AND its model
# is promoted in the catalog. Fallback order: Higgsfield -> Wan 2.2 -> LTX-Video
# -> CogVideoX -> SVD -> AnimateDiff -> Mochi-1 (premium hosted primary, then
# open-weight/paid-safe fallbacks).
# Higgsfield: premium hosted video with camera/motion presets (i2v + t2v).
HIGGSFIELD_API_KEY=
# fal.ai: hosts the open-weight fal fallbacks LTX-Video ("ltx_fal"), Stable Video
# Diffusion ("svd"), AnimateDiff ("animatediff"), Mochi-1 ("mochi") and the
# reference-only HunyuanVideo ("hunyuanvideo"). One shared credential for all.
FAL_API_KEY=
# CogVideoX-2B self-hosted OSS fallback (near-zero marginal cost). Key optional
# if the internal endpoint is unauthenticated; set COGVIDEOX_BASE_URL to point it.
COGVIDEOX_API_KEY=
# COGVIDEOX_BASE_URL=https://cogvideox.internal.reelforge.app
# Wan 2.2 (open weights, Apache-2.0) reuses REPLICATE_API_TOKEN above.
# HunyuanVideo is NON-COMMERCIAL with an EU/UK/KR territorial exclusion, so it is
# reference-only: it never auto-registers even when FAL_API_KEY is set. Opt in
# explicitly (non-global / research use only) with this flag:
# REELFORGE_ENABLE_HUNYUANVIDEO_REFERENCE=1

# Spend protection (server-enforced; see DEPLOY.md "AI video spend protection"):
AI_VIDEO_CREDIT_COST=3        # credits debited per AI render
AI_VIDEO_DAILY_CAP=20         # max AI renders per UTC day, ALL users combined
AI_VIDEO_USER_DAILY_CAP=2     # max AI renders per UTC day per account

# === BILLING RAILS (only needed when REELFORGE_CHECKOUT_ENABLED=true) ========
# Each rail appears in GET /billing/providers only when BOTH its keys are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
CREEM_API_KEY=
# Optional with Creem: payments are confirmed from the signed success redirect
# (POST /billing/creem/confirm); the webhook is a backup when set.
CREEM_WEBHOOK_SECRET=
# Creem product ids (not secret). Create them with
#   python apps/api/tools/ops/create_creem_products.py          (dry run)
#   python apps/api/tools/ops/create_creem_products.py --apply  (creates, prints these lines)
# The $1 card check that unlocks the free signup reels on the web (credited as 1 reel):
CREEM_PRODUCT_ID_CARD_CHECK=
CREEM_PRODUCT_ID_STARTER=
CREEM_PRODUCT_ID_PRO=
# Public web origin for checkout return URLs (default https://menivor.com).
# MENIVOR_WEB_URL=https://menivor.com
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# === REVENUECAT (native-app entitlement verification) — optional ============
# Server-side SECRET REST key (never an EXPO_PUBLIC_* key). Empty = export/share
# entitlement checks degrade open.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PRO_ENTITLEMENT_ID=pro

# === OBSERVABILITY (Sentry) — optional; empty = NO-OP =======================
# Required by the production release gate; empty is fine for internal_pilot.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# === LAUNCH FLAGS (fail-closed; keep false until publicly approved) =========
REELFORGE_PUBLIC_LAUNCH_APPROVED=false
REELFORGE_SIGNUP_ENABLED=false
REELFORGE_CHECKOUT_ENABLED=false
REELFORGE_PUBLISHING_ENABLED=false
# Pilot staff (comma-separated user emails and/or user ids) may publish and
# check out while the flags above are closed. Empty = nobody.
REELFORGE_PILOT_STAFF=

# === DIRECT-PUBLISH social APIs (TikTok / Instagram Reels / YouTube Shorts) ==
# Two credential models are supported and both are OPTIONAL:
#
#  1. Per-creator OAuth connect (multi-tenant): a creator links their account via
#     GET /connections/{provider}/authorize -> callback. This uses the OAuth *app*
#     credentials below; the per-user access token is stored encrypted, not here.
#  2. Env single-account fallback (self-host): set <P>_ACCESS_TOKEN to post to one
#     owned account when no per-user token is present.
#
# Empty = that platform's publish degrades cleanly (a clear error), never crashes.
#
# --- OAuth app credentials (shared by connect + refresh) ---
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
#
# --- Single-account env fallback (optional; used when no per-user token) ---
TIKTOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
# Instagram Graph API needs the IG *user* id (also read from INSTAGRAM_USER_ID).
INSTAGRAM_EXTERNAL_ACCOUNT_ID=
YOUTUBE_ACCESS_TOKEN=
#
# Fernet key that encrypts stored per-creator OAuth tokens at rest (connect flow).
# Also encrypts per-user Buffer and Typefully API keys (POST /scheduler/connections).
# Required before anyone can save a scheduler key. Generate any long random secret.
SOCIAL_TOKEN_KEY=

# Hosted MCP (app.domains.mcp_hosted): list_scheduler_accounts and
# schedule_to_buffer_or_typefully stay hidden until this is 1, true, yes, or on.
# The web MCP server reads the same name (see apps/web/.env.example). Default off.
# MENIVOR_MCP_SCHEDULER_TOOLS=

# === TYPESAFE / JEV — optional; empty = graceful pass-through ===============
# Powers the Winning Hook Ranker (POST /api/v1/growth/rank-hooks). When empty the
# endpoint still returns 200 with "degraded": true (input order, no AI scoring).
# Get a key at https://typesafe.ai. NEVER commit a real key.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
TYPESAFE_MODEL=jev-latest

# === MINT SETTLEMENT + IDENTITY LOCK — optional (local ledger when empty) ===
MINT_SERVER_URL=
MINT_API_KEY=
MINT_TREASURY_ACCOUNT=
MINT_ATTESTATION_PUBLIC_KEYS_JSON={}
IDENTITY_LOCK_URL=
IDENTITY_LOCK_API_KEY=

# Rally lifecycle events (dogfood Rally journeys; OFF unless the key is set).
# Server-side only. Events: signed_up, first_reel_rendered, reel_published,
# credits_purchased, email_consent_changed (see app/integrations/rally).
RALLY_EVENTS_KEY=
RALLY_EVENTS_URL=https://vcpeer.com
# RALLY_EVENTS_TIMEOUT_SECONDS=3

# === CLERK (web sign-in) =======================================================
# The web sends the signed-in Clerk session token; the API verifies it. Set the
# secret key (verifies via the Clerk Backend API JWKS, no Frontend API DNS
# needed) and the issuer (the Frontend API origin, checked against "iss").
CLERK_SECRET_KEY=
CLERK_ISSUER=
# CLERK_JWKS_URL=
# CLERK_AUDIENCE=

# === MENIVOR WAVE 2026-10-06: Integrations, Ad Clone, Brand Agent ===========
# Settings > Integrations (ad accounts, Ads agent, Slack, product imports).
# Tokens are encrypted with SOCIAL_TOKEN_KEY (above). Each provider is off until
# its app keys are set.
# MENIVOR_INTEGRATIONS_REDIRECT_URL=   # default: $MENIVOR_WEB_URL/settings/integrations/callback
MENIVOR_META_APP_ID=
MENIVOR_META_APP_SECRET=
# GOOGLE_ADS_CLIENT_ID= GOOGLE_ADS_CLIENT_SECRET= GOOGLE_ADS_DEVELOPER_TOKEN=
# MENIVOR_TIKTOK_APP_ID= MENIVOR_TIKTOK_APP_SECRET=
# SLACK_CLIENT_ID= SLACK_CLIENT_SECRET= SLACK_SIGNING_SECRET=
# Ad Clone: every route answers 403 until ADCLONE_ENABLED=1. Paid renders stay
# off until ADCLONE_PAID_RENDER=1 (credits held per render, capped by ADCLONE_CAP_USD).
ADCLONE_ENABLED=0
ADCLONE_PAID_RENDER=0
# ADCLONE_CAP_USD=6
# Brand Agent (/agent). The Ad Clone and Integrations adapters load on their own.
# Ad Clone product for the agent when brand memory does not name one:
# BRAND_AGENT_ADCLONE_PRESET=your-brand-preset-id
# Web search: a self-hosted SearXNG (deploy/searxng). Unset = search off.
SEARXNG_URL=
# BRAND_AGENT_SEARCH=none   # force search off even when SEARXNG_URL is set
# Launch Kit competitor backlinks (app/domains/launch_kit/backlinks.py).
# CrawlGraph is free (15 calls/month, no card) and preferred when set; DataForSEO
# (paid) is the fallback. Neither is ever called unless allow_live=true is passed.
CRAWLGRAPH_API_KEY=
# DATAFORSEO_LOGIN= DATAFORSEO_PASSWORD=
