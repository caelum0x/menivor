{
  "name": "reelforge-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Menivor: AI video maker. Prompts, links and footage become captioned vertical reels (Expo + expo-router).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "typecheck:expo": "tsc --noEmit -p tsconfig.json",
    "test:wallet": "vitest run --config vitest.wallet.config.ts",
    "test:product": "vitest run --config vitest.product.config.ts",
    "test:features": "vitest run --config vitest.features.config.ts",
    "test:studio": "vitest run --config vitest.studio.config.ts",
    "test:publishing": "vitest run --config vitest.publishing.config.ts",
    "test:billing": "vitest run --root ../.. apps/mobile/src/shared/billing/__tests__/entitlement-policy.test.ts",
    "test": "npm run test:wallet && npm run test:product && npm run test:features && npm run test:studio && npm run test:publishing && npm run test:billing && npm run test:release && npm run test:auth",
    "test:release": "vitest run --config vitest.release.config.ts",
    "test:auth": "vitest run --config vitest.auth.config.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^13.2.0",
    "@reelforge/api-contract": "file:../../packages/api-contract",
    "@reelforge/effects-core": "file:../../packages/effects-core",
    "@reelforge/growth-analytics": "file:../../packages/growth-analytics",
    "@reelforge/provider-adapter-kit": "file:../../packages/provider-adapter-kit",
    "@reelforge/trends-schema": "file:../../packages/trends-schema",
    "@supabase/supabase-js": "^2.45.4",
    "expo": "^54",
    "expo-apple-authentication": "~8.0.8",
    "expo-av": "~16.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-purchases": "10.5.0",
    "react-native-purchases-ui": "10.5.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.1.10",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2",
    "vitest": "^2.1.9"
  }
}
