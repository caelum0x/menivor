# Base URL of the ReelForge backend, including the /api/v1 prefix.
# Use your machine's LAN IP (not localhost) when testing on a physical device.
EXPO_PUBLIC_API_BASE=http://localhost:8080/api/v1

# Waitlist mode (mirrors the web app). ON unless explicitly set to "0". While on,
# sign-in fails open to the waitlist home and the Create tab shows the
# waitlist-era experience instead of dead-ending against a keyless backend.
# Set to "0" only once production generation-provider keys are live.
EXPO_PUBLIC_WAITLIST_MODE=1

# Absolute waitlist signup endpoint (the mobile app is not served from the web
# origin). Defaults to https://menivor.com/api/waitlist when unset.
EXPO_PUBLIC_WAITLIST_URL=https://menivor.com/api/waitlist

# Optional public app-level API key used as the x-api-key fallback when the
# user has not entered their own key on the sign-in screen. Non-secret.
EXPO_PUBLIC_APP_API_KEY=

# RevenueCat app-specific PUBLIC SDK keys. These are safe to include in a
# client build. Never place a RevenueCat secret API key in an EXPO_PUBLIC_* var.
# Configure only the platforms you build; a missing platform key fails closed.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=

# Entitlement identifier configured in RevenueCat. Defaults to "pro".
EXPO_PUBLIC_REVENUECAT_PRO_ENTITLEMENT_ID=pro

# Public help-center URL or mailto link shown in the in-app Support screen.
EXPO_PUBLIC_SUPPORT_URL=

# --- Legal (App Store / Play compliance) --------------------------------------
# Public Terms of Service (EULA) and Privacy Policy URLs. Linked from the sign-in
# screen and every paywall surface (Apple Guideline 3.1.2). Both MUST resolve to
# LIVE pages before submission — a 404 is a guaranteed review rejection. Default
# to the canonical Menivor URLs when unset.
EXPO_PUBLIC_TERMS_URL=https://menivor.app/terms
EXPO_PUBLIC_PRIVACY_URL=https://menivor.app/privacy

# --- Supabase social sign-in (optional) ---------------------------------------
# URL + anon key of Menivor's own Scribase project (Supabase-compatible).
# ~/products/deploy-scripts/scribase-move-apps.sh writes them into the EAS
# environment variables and .env.local. When either is absent, social sign-in is
# disabled and the app falls back to the existing device/API-key account.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Google sign-in -----------------------------------------------------------
# OAuth client ids from Google Cloud. The WEB client id is required for the
# native @react-native-google-signin flow (it is the audience Supabase verifies).
# The iOS client id is optional but recommended on iOS; its reversed form also
# goes into app.json (google-signin plugin iosUrlScheme).
#
# CURRENTLY DISABLED: the app ships under bundle id com.arhansuba.menivor, which
# has no Google iOS OAuth client yet, so Google sign-in degrades gracefully
# (button hidden, honest "unavailable" note) and these are intentionally unset in
# eas.json's production env. To RE-ENABLE Google for this bundle:
#   1. In Google Cloud, create an iOS OAuth client for com.arhansuba.menivor.
#   2. Add the google-signin plugin back to app.json with its iosUrlScheme
#      (the reversed iOS client id).
#   3. Restore EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID / _IOS_CLIENT_ID in eas.json
#      build.production.env.
#   4. Re-prebuild and rebuild. isGoogleSignInSupported() then flips to true.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# --- AdMob (optional) ---------------------------------------------------------
# Master switch for the in-app banner. Must be the literal string "true" to show
# ads; anything else (or unset) keeps ads off. Premium users never see ads.
EXPO_PUBLIC_ADS_ENABLED=false
# Per-platform banner ad unit ids. Leave blank to use Google test ids in dev.
# The AdMob APP ids (ca-app-pub-...~...) go in app.json, not here.
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=

# --- Lab screens (dev sessions only) ------------------------------------------
# Opens the internal screens (labs, admin, developer/API keys, Mint token
# transfers, marketplaces, team admin). Off by default; only "1" turns it on and
# only in a Metro dev session. Store builds can never reach those routes. Never
# set it in eas.json.
EXPO_PUBLIC_ENABLE_LAB=0
