.DS_Store
# Local credentials and deployment overrides. Commit only explicit examples.
.env
.env.*
!.env.example
!**/.env.example
!.env.*.example
!**/.env.*.example
.dev.vars
**/.dev.vars
.dev.vars.*
**/.dev.vars.*
!.dev.vars.example
!**/.dev.vars.example
.wrangler/
**/.wrangler/
/config.toml
/config.toml.bak
/storage/
/apps/api/runtime/storage/*
!/apps/api/runtime/storage/.gitkeep
/.idea/
/app/services/__pycache__
/app/__pycache__/
/app/config/__pycache__/
/app/models/__pycache__/
/app/utils/__pycache__/
/*/__pycache__/*
.vscode
/**/.streamlit
__pycache__
logs/

node_modules
# VuePress 默认临时文件目录
/sites/docs/.vuepress/.temp
# VuePress 默认缓存目录
/sites/docs/.vuepress/.cache
# VuePress 默认构建生成的静态文件目录
/sites/docs/.vuepress/dist
# 模型目录
/models/
./models/*

venv/
.venv

# Debug and test files
CLAUDE.md
debug/
debug_*.py
test_*.py
!test/services/test_*.py
!test/test_*.py
streamlit.log
.coverage
coverage.xml
htmlcov/
.codegraph
/docs/superpowers
.understand-anything

# ReelForge local
.venv/
config.toml
web/node_modules/
web/.next/
mobile/node_modules/
/target/
# Rust build artifacts in ANY workspace (apps/mint, apps/vend, apps/relay/crates, apps/turnstile, apps/abacus, apps/agent-runtime, apps/desktop, ...)
target/
**/target/
# Node build artifacts in any app
**/node_modules/
**/.next/

# ReelForge ships its own test suite (overrides the global test_*.py ignore)
!tests/reelforge/test_*.py
!apps/api/tests/**/test_*.py
# External checkouts are local/vendor research. Keep only their governance
# registry in product source control.
external/*
!external/REGISTRY.md

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
.gstack/

# --- vendored OSS build bases (independent git repos; see clone-these mapping) ---
/wolfcut/
/openscreen/
